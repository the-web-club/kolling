    "@types/node": "^22.19.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.3.1",
    "style-dictionary": "^5.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
