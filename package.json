    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.4",
    "style-dictionary": "^5.5.5",
    "tailwindcss": "^4.3.3",
