---
interface Props {
  kop: string;
  items: readonly string[];
}

const { kop, items } = Astro.props;
---

<div class="materiaal-lijst">
  <h3 class="kop">{kop}</h3>
  <ul class="lijst">
    {items.map((item) => <li class="item">{item}</li>)}
  </ul>
</div>

<style>
  .kop {
    margin-block-end: var(--ruimte-stapel-md);
    font-family: var(--tekst-lopend-familie);
    font-size: var(--tekst-label-grootte);
    font-weight: var(--tekst-label-gewicht);
    letter-spacing: var(--tekst-label-spatiering);
    text-transform: uppercase;
    color: var(--kleur-voorgrond-subtiel);
  }

  .lijst {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    padding-block: var(--ruimte-stapel-sm);
    border-block-end: var(--k-rand-haarlijn) solid var(--kleur-lijn);
  }
</style>
