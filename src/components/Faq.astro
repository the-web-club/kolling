---
import { Chevron } from '@/components/iconen';

interface Props {
  vragen: readonly { vraag: string; antwoord: string }[];
}

const { vragen } = Astro.props;
---

<div class="faq">
  {
    vragen.map((item) => (
      <details class="vraag" name="faq">
        <summary class="opener">
          <span class="titel">{item.vraag}</span>
          <Chevron />
        </summary>
        <p class="antwoord">{item.antwoord}</p>
      </details>
    ))
  }
</div>

<style>
  .vraag {
    border-block-end: var(--k-rand-haarlijn) solid var(--kleur-lijn);
  }

  .opener {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ruimte-stapel-md);
    min-block-size: 3rem;
    padding-block: var(--ruimte-stapel-md);
    cursor: pointer;
    list-style: none;
  }

  .opener::-webkit-details-marker {
    display: none;
  }

  .titel {
    font-family: var(--tekst-kop4-familie);
    font-size: var(--tekst-kop4-grootte);
    font-weight: var(--tekst-kop4-gewicht);
  }

  .antwoord {
    padding-block-end: var(--ruimte-stapel-lg);
    color: var(--kleur-voorgrond-gedempt);
  }

  @media (prefers-reduced-motion: no-preference) {
    .opener :global(.chevron) {
      transition: rotate var(--beweging-hover);
    }

    .vraag[open] .opener :global(.chevron) {
      rotate: 180deg;
    }
  }
</style>
