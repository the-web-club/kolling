---
import { Picture } from 'astro:assets';
import woordmerk from '@/assets/merk/woordmerk.png';
import Menu from '@/components/Menu.astro';
import Navigatie from '@/components/Navigatie.astro';
import TekstLink from '@/components/TekstLink.astro';
import { haalInstellingen } from '@/lib/content';

const { naam, adres, cta } = await haalInstellingen();
const isContact = Astro.url.pathname === '/contact';
---

<header class="pagina-kop">
  <a
    class="merk"
    href="/"
    aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
    data-onthul="fade"
  >
    <Picture
      src={woordmerk}
      formats={['avif', 'webp']}
      alt={naam}
      width={70}
      densities={[2]}
      loading="eager"
      fetchpriority="high"
    />
  </a>

  <Navigatie />

  <div class="kop-rechts">
    <p class="klok" data-onthul="fade" transition:persist="klok">
      {adres.plaats}<time data-klok></time>
    </p>

    <p class="cta" data-onthul="fade">
      <TekstLink href="/contact" variant="intekenend" huidig={isContact}>{cta.primair}</TekstLink>
    </p>
  </div>

  <Menu />
</header>

<script is:inline>
  const klok = document.querySelector('[data-klok]');
  if (klok && !klok.hasAttribute('data-gekoppeld')) {
    klok.setAttribute('data-gekoppeld', '');
    const opmaak = new Intl.DateTimeFormat('nl-NL', {
      timeZone: 'Europe/Amsterdam',
      hour: '2-digit',
      minute: '2-digit',
    });
    const zetTijd = () => {
      const nu = new Date();
      klok.dateTime = nu.toISOString();
      klok.textContent = `, ${opmaak.format(nu)}`;
    };
    zetTijd();
    setInterval(zetTijd, 60000);
  }
</script>

<style>
  /* Vier cellen op smalle schermen: woordmerk, navigatie, klok en de knop naar
     het menu. Onder 1024 px staan de zes items in het menu en blijft hun cel
     leeg. Vanaf 1024 px verdwijnt de knop en staat naast de klok de link naar
     het bespreken van een idee.

     De rij is zo hoog als het woordmerk, zodat het aanraakdoel van 44 px van
     de knop naar het menu de kop niet hoger maakt. Het overschot valt in de
     padding, gelijk boven en onder. */
  .pagina-kop {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--kop-laag);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-rows: var(--merk-hoogte);
    align-items: center;
    column-gap: var(--kop-kolom-ruimte);
    padding-block: var(--kop-padding-blok);
  }

  /* In rust loopt de lichtachtergrond onder de kop door. Na acht pixels
     scrollen dekt deze band hem af, over de volle breedte van het venster,
     net als de haarlijn onder de contactrij. */
  .pagina-kop::before {
    content: '';
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: -1;
    block-size: var(--kop-hoogte);
    background-color: var(--kop-achtergrond);
    border-block-end: var(--kop-lijn-dikte) solid var(--kop-lijn);
    opacity: 0;
  }

  @supports (animation-timeline: scroll(root)) {
    .pagina-kop::before {
      animation-name: kop-dekt;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-timeline: scroll(root);
      animation-range: 0 var(--kop-drempel);
    }
  }

  @keyframes kop-dekt {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .merk {
    --onthul-vertraging: var(--binnenkomst-kop);
    display: flex;
    align-items: center;
    grid-column: 1;
    justify-self: start;
    line-height: 0;
  }

  /* Zonder display: block houdt de inline afbeelding ruimte onder de basislijn
     over en staat het woordmerk een paar pixels te hoog in de rij. */
  .merk :global(picture),
  .merk :global(img) {
    display: block;
  }

  .merk :global(img) {
    block-size: var(--merk-hoogte);
    inline-size: auto;
    filter: var(--filter-woordmerk);
  }

  /* Onder 1024 px blijft de klok een eigen cel en is de CTA verborgen: die
     staat dan in het menu. Vanaf 1024 px vormen klok en CTA samen de
     rechterkolom, zodat de navigatie in het midden blijft. */
  .kop-rechts {
    display: contents;
  }

  .klok {
    --onthul-vertraging: var(--binnenkomst-kop);
    grid-column: 3;
    justify-self: end;
    font-size: var(--tekst-klein-grootte);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--kleur-voorgrond-gedempt);
  }

  .cta {
    --onthul-vertraging: var(--binnenkomst-kop);
    display: none;
    margin: 0;
    font-size: var(--tekst-klein-grootte);
    line-height: 1;
    white-space: nowrap;
    color: var(--kleur-voorgrond);
  }

  @media (max-width: 359.98px) {
    .klok {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .pagina-kop {
      grid-template-rows: var(--merk-hoogte-breed);
    }

    .pagina-kop::before {
      block-size: var(--kop-hoogte-breed);
    }

    .merk :global(img) {
      block-size: var(--merk-hoogte-breed);
    }
  }

  @media (min-width: 1024px) {
    .pagina-kop {
      grid-template-columns: auto 1fr auto;
    }

    .kop-rechts {
      display: flex;
      grid-column: 3;
      align-items: center;
      gap: var(--kop-kolom-ruimte);
    }

    .klok {
      grid-column: auto;
      justify-self: auto;
    }

    .cta {
      display: block;
    }
  }
</style>
