---
import { Picture } from 'astro:assets';
import woordmerk from '@/assets/merk/woordmerk.png';
import Menu from '@/components/Menu.astro';
import Navigatie from '@/components/Navigatie.astro';
import { haalInstellingen } from '@/lib/content';

const { naam, adres } = await haalInstellingen();
---

<header class="pagina-kop">
  <a
    class="merk"
    href="/"
    aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
    data-onthul="fade"
  >
    <Picture
      src={woordmerk}
      formats={['avif', 'webp']}
      alt={naam}
      width={70}
      height={35}
      densities={[2]}
      loading="eager"
      fetchpriority="high"
    />
  </a>

  <Navigatie />

  <p class="klok" data-onthul="fade" transition:persist="klok">
    {adres.plaats}<time data-klok></time>
  </p>

  <Menu />
</header>

<script is:inline>
  const klok = document.querySelector('[data-klok]');
  if (klok && !klok.hasAttribute('data-gekoppeld')) {
    klok.setAttribute('data-gekoppeld', '');
    const opmaak = new Intl.DateTimeFormat('nl-NL', {
      timeZone: 'Europe/Amsterdam',
      hour: '2-digit',
      minute: '2-digit',
    });
    const zetTijd = () => {
      const nu = new Date();
      klok.dateTime = nu.toISOString();
      klok.textContent = `, ${opmaak.format(nu)}`;
    };
    zetTijd();
    setInterval(zetTijd, 60000);
  }
</script>

<style>
  /* Drie cellen op elke breedte. Onder 64 rem staat de klok in de middelste
     cel en de knop naar het menu in de derde; vanaf 64 rem schuift de
     navigatie ertussen en gaat de klok naar rechts. */
  .pagina-kop {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: var(--ruimte-stapel-md);
  }

  .merk {
    --onthul-vertraging: var(--binnenkomst-kop);
    grid-column: 1;
  }

  .merk :global(img) {
    display: block;
    block-size: var(--merk-hoogte);
    inline-size: auto;
  }

  .klok {
    --onthul-vertraging: var(--binnenkomst-kop);
    grid-column: 2;
    justify-self: end;
    font-size: var(--tekst-klein-grootte);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--kleur-voorgrond-gedempt);
  }

  @media (max-width: 22.4375rem) {
    .klok {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .merk :global(img) {
      block-size: var(--merk-hoogte-breed);
    }
  }

  @media (min-width: 64rem) {
    .pagina-kop {
      grid-template-columns: 1fr auto 1fr;
    }

    .klok {
      grid-column: 3;
    }
  }

  /* Vanaf 64 rem staat de navigatie in de koprij en komt de kop van de pagina
     er vlak onder. De extra ruimte valt weg op korte schermen, waar de pagina
     binnen één beeld moet blijven. */
  @media (min-width: 64rem) and (min-height: 44.0625rem) {
    .pagina-kop {
      padding-block-end: var(--pagina-kopruimte-breed);
    }
  }
</style>
