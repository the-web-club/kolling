---
interface Props {
  richting?: 'onder' | 'rechts';
}

const { richting = 'onder' } = Astro.props;
---

<svg
  class="chevron"
  data-richting={richting}
  viewBox="0 0 16 16"
  width="16"
  height="16"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  aria-hidden="true"
  focusable="false"
>
  <path d="M3 6 8 11 13 6" />
</svg>

<style>
  .chevron[data-richting='rechts'] {
    rotate: -90deg;
  }
</style>
