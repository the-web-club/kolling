---
import Beeld from '@/components/Beeld.astro';
import Knop from '@/components/Knop.astro';
import type { Beeld as BeeldType } from '@/lib/content';

interface Props {
  kop: string;
  intro: string;
  beeld?: BeeldType;
  primair?: { naam: string; pad: string };
  secundair?: { naam: string; pad: string };
}

const { kop, intro, beeld, primair, secundair } = Astro.props;
---

<section class="hero">
  <div class="tekst" data-binnenkomst="hero">
    <h1 class="kop" data-onthul="regels">{kop}</h1>
    <p class="intro">{intro}</p>
    {
      (primair || secundair) && (
        <div class="acties">
          {primair && <Knop href={primair.pad}>{primair.naam}</Knop>}
          {secundair && (
            <Knop href={secundair.pad} variant="omlijnd">
              {secundair.naam}
            </Knop>
          )}
        </div>
      )
    }
  </div>

  {
    beeld && (
      <div class="beeld">
        <Beeld beeld={beeld} prioriteit parallax onthul={false} />
      </div>
    )
  }
</section>

<style>
  .tekst {
    display: grid;
    gap: var(--ruimte-stapel-lg);
    grid-column: 1 / -1;
    align-content: center;
  }

  .kop {
    font-size: var(--tekst-display-grootte);
    line-height: var(--tekst-display-regelhoogte);
    letter-spacing: var(--tekst-display-spatiering);
  }

  .intro {
    font-size: var(--tekst-intro-grootte);
    line-height: var(--tekst-intro-regelhoogte);
    color: var(--kleur-voorgrond-gedempt);
  }

  .acties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ruimte-stapel-md);
  }

  .beeld {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .tekst {
      grid-column: 1 / span 6;
    }

    .beeld {
      grid-column: 8 / span 5;
    }
  }
</style>
