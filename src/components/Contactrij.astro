---
import ContactLink from '@/components/ContactLink.astro';
import TekstLink from '@/components/TekstLink.astro';
import ThemaSchakelaar from '@/components/ThemaSchakelaar.astro';
import { Envelop, Instagram, Pin, Telefoon, Whatsapp } from '@/components/iconen';
import { haalInstellingen, isBekend } from '@/lib/content';

const instellingen = await haalInstellingen();
const { adres, telefoon } = instellingen;

const heeftEmail = isBekend(instellingen.email);

// De adresregel en de microregel staan in de frontmatter, niet in de template:
// een regelafbreking tussen twee expressies verdwijnt in de uitvoer en plakt
// dan woorden aan elkaar.
//
// In twee kolommen past het adres niet op één regel. Harde spaties laten de
// regel alleen na de komma afbreken, nooit binnen de postcode.
const hardeSpaties = (tekst: string) => tekst.replaceAll(' ', '\u00a0');
const adresregel = `${hardeSpaties(adres.straat)}, ${hardeSpaties(`${adres.postcode} ${adres.plaats}`)}`;
const microregel = isBekend(instellingen.kvk)
  ? `${instellingen.naam}, ${adres.plaats}, KvK ${instellingen.kvk}`
  : `${instellingen.naam}, ${adres.plaats}`;
---

<footer class="contactrij" transition:persist="contactrij">
  <div class="lijn" data-onthul="lijn"></div>

  <div class="blokken">
    <div class="blok" data-onthul="omhoog">
      <h2 class="label">Werkplaats</h2>
      <address class="regels">
        <span class="regel-met-icoon"><Pin />{adresregel}</span>
        <span class="noot">Bezoek op afspraak</span>
      </address>
    </div>

    <div class="blok" data-onthul="omhoog">
      <h2 class="label">
        <TekstLink href="/contact" variant="intekenend">
          {instellingen.cta.primair}
        </TekstLink>
      </h2>
      <div class="regels">
        <ContactLink href={`tel:${telefoon.e164}`} tekst={telefoon.weergave}>
          <Telefoon />
        </ContactLink>
        <ContactLink href={instellingen.whatsapp} tekst="WhatsApp">
          <Whatsapp />
        </ContactLink>
        {
          heeftEmail && (
            <ContactLink href={`mailto:${instellingen.email}`} tekst={instellingen.email}>
              <Envelop />
            </ContactLink>
          )
        }
      </div>
    </div>

    <div class="blok" data-onthul="omhoog">
      <h2 class="label">Volg het werk</h2>
      <div class="regels">
        <ContactLink href={instellingen.instagram} tekst="Instagram">
          <Instagram />
        </ContactLink>
      </div>
    </div>
  </div>

  <div class="voetregel">
    <ThemaSchakelaar />
    <p class="micro" data-onthul="fade">{microregel}</p>
  </div>
</footer>

<style>
  .contactrij {
    display: grid;
    gap: var(--pagina-micro-ruimte);
  }

  /* De haarlijn loopt tot de rand van de pagina, niet tot 100vw. Op iOS telt
     vw een scrollbreedte mee en rekt die het scherm op. */
  .lijn {
    --onthul-vertraging: var(--binnenkomst-lijn);
    inline-size: calc(100% + 2 * var(--pagina-padding));
    margin-inline-start: calc(-1 * var(--pagina-padding));
    block-size: var(--k-rand-haarlijn);
    background-color: var(--kleur-lijn);
  }

  .blokken {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--pagina-blok-ruimte) var(--ruimte-goot);
  }

  .blok {
    display: grid;
    gap: var(--ruimte-stapel-sm);
    grid-column: 1 / -1;
    align-content: start;
    font-size: var(--tekst-klein-grootte);
    line-height: var(--tekst-lopend-regelhoogte);
  }

  .blok:nth-child(1) {
    --onthul-vertraging: var(--binnenkomst-blok-een);
  }

  .blok:nth-child(2) {
    --onthul-vertraging: var(--binnenkomst-blok-twee);
  }

  .blok:nth-child(3) {
    --onthul-vertraging: var(--binnenkomst-blok-drie);
  }

  .label {
    font-family: var(--tekst-label-familie);
    font-size: var(--tekst-label-grootte);
    font-weight: var(--tekst-label-gewicht);
    letter-spacing: var(--tekst-label-spatiering);
    text-transform: uppercase;
    color: var(--kleur-voorgrond-gedempt);
  }

  .regels {
    display: grid;
    gap: var(--ruimte-stapel-sm);
    justify-items: start;
  }

  .regel-met-icoon {
    display: inline-flex;
    align-items: center;
    gap: var(--icoon-ruimte);
  }

  .regel-met-icoon :global(.icoon) {
    flex-shrink: 0;
    color: var(--icoon-voorgrond);
  }

  .noot {
    padding-inline-start: calc(var(--icoon-maat) + var(--icoon-ruimte));
  }

  .voetregel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ruimte-stapel-md);
  }

  .micro {
    --onthul-vertraging: var(--binnenkomst-micro);
    max-inline-size: none;
    font-size: var(--tekst-label-grootte);
    text-align: end;
    color: var(--kleur-voorgrond-subtiel);
  }

  /* Twee kolommen zodra het past, zodat de voet een rij korter wordt en er
     ruimte vrijkomt voor het beeld. De leesvolgorde blijft de DOM-volgorde:
     werkplaats, contact, Instagram. */
  @media (min-width: 360px) and (max-width: 767.98px) {
    .blokken {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .blok:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }

    .blok:nth-child(2) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .blok:nth-child(3) {
      grid-column: 1;
      grid-row: 2;
      margin-block-start: var(--ruimte-stapel-md);
    }
  }

  @media (min-width: 768px) {
    .lijn {
      inline-size: calc(100% + 2 * var(--pagina-padding-breed));
      margin-inline-start: calc(-1 * var(--pagina-padding-breed));
    }

    .blokken {
      gap: var(--pagina-blok-ruimte-breed) var(--ruimte-goot);
    }

    .blok:nth-child(1) {
      grid-column: 2 / span 3;
    }

    .blok:nth-child(2) {
      grid-column: 5 / span 3;
    }

    .blok:nth-child(3) {
      grid-column: 8 / span 3;
    }
  }
</style>
