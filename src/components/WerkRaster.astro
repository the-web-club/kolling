---
import WerkKaart from '@/components/WerkKaart.astro';
import type { Project } from '@/lib/content';

interface Props {
  projecten: readonly Project[];
}

const { projecten } = Astro.props;

const RITME = ['breed', 'staand', 'liggend', 'vierkant', 'staand', 'liggend'] as const;
---

<div class="werk-raster">
  {
    projecten.map((project, index) => (
      <div class="plek" data-plek={index % RITME.length}>
        <WerkKaart project={project} verhouding={RITME[index % RITME.length]} />
      </div>
    ))
  }
</div>

<style>
  .werk-raster {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--ruimte-rij-lg) var(--ruimte-goot);
  }

  .plek {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .plek[data-plek='0'] {
      grid-column: 1 / span 12;
    }

    .plek[data-plek='1'] {
      grid-column: 1 / span 5;
    }

    .plek[data-plek='2'] {
      grid-column: 7 / span 6;
      align-self: end;
    }

    .plek[data-plek='3'] {
      grid-column: 2 / span 4;
    }

    .plek[data-plek='4'] {
      grid-column: 8 / span 5;
    }

    .plek[data-plek='5'] {
      grid-column: 1 / span 7;
    }
  }
</style>
