---
import type { Afmetingen } from '@/lib/content';
import { formatteerAfmetingen, formatteerLijst } from '@/lib/formatteer';

interface Props {
  titel: string;
  materialen: readonly string[];
  afmetingen: Afmetingen;
  afwerking?: string;
  jaar?: number;
  compact?: boolean;
}

const { titel, materialen, afmetingen, afwerking, jaar, compact = false } = Astro.props;
---

<dl class="museum-label" data-variant={compact ? 'compact' : 'volledig'}>
  <dt class="verborgen">Titel</dt>
  <dd class="titel">{titel}</dd>

  <dt class="verborgen">Materiaal</dt>
  <dd class="meta">{formatteerLijst(materialen)}</dd>

  <dt class="verborgen">Afmetingen</dt>
  <dd class="meta">{formatteerAfmetingen(afmetingen)}</dd>

  {
    afwerking && !compact && (
      <>
        <dt class="verborgen">Afwerking</dt>
        <dd class="meta">{afwerking}</dd>
      </>
    )
  }

  {
    jaar && (
      <>
        <dt class="verborgen">Jaar</dt>
        <dd class="meta">{jaar}</dd>
      </>
    )
  }
</dl>

<style>
  .museum-label {
    display: grid;
    gap: var(--ruimte-stapel-sm);
    margin: 0;
  }

  .verborgen {
    position: absolute;
    clip-path: inset(50%);
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
  }

  .titel {
    margin: 0;
    font-family: var(--tekst-kop4-familie);
    font-size: var(--tekst-kop4-grootte);
    font-weight: var(--tekst-kop4-gewicht);
    line-height: var(--tekst-kop4-regelhoogte);
  }

  .meta {
    margin: 0;
    font-size: var(--tekst-klein-grootte);
    line-height: var(--tekst-klein-regelhoogte);
    font-variant-numeric: tabular-nums;
    color: var(--kleur-voorgrond-subtiel);
  }

  .museum-label[data-variant='compact'] {
    gap: 0;
  }
</style>
