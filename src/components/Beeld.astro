---
import { Image } from 'astro:assets';
import Plaatshouder from '@/components/Plaatshouder.astro';
import type { Beeld } from '@/lib/content';

interface Props {
  beeld: Beeld;
  prioriteit?: boolean;
  parallax?: boolean;
  onthul?: boolean;
}

const { beeld, prioriteit = false, parallax = false, onthul = true } = Astro.props;
---

<figure class="beeld" data-onthul={onthul ? 'gordijn' : undefined}>
  <div class="kader" data-verhouding={beeld.verhouding} data-parallax={parallax ? '' : undefined}>
    {
      'plaatshouder' in beeld ? (
        <Plaatshouder tint={beeld.plaatshouder.tint} label={beeld.plaatshouder.label} />
      ) : (
        <Image
          class="afbeelding"
          src={beeld.bron}
          alt={beeld.alt}
          loading={prioriteit ? 'eager' : 'lazy'}
          fetchpriority={prioriteit ? 'high' : 'auto'}
          widths={[640, 960, 1440, 1920]}
          sizes="(min-width: 64rem) 50vw, 100vw"
        />
      )
    }
  </div>
  {beeld.bijschrift && <figcaption>{beeld.bijschrift}</figcaption>}
</figure>

<style>
  .kader {
    overflow: hidden;
    background-color: var(--kleur-achtergrond-tint);
  }

  .kader[data-verhouding='liggend'] {
    aspect-ratio: var(--k-verhouding-liggend);
  }

  .kader[data-verhouding='staand'] {
    aspect-ratio: var(--k-verhouding-staand);
  }

  .kader[data-verhouding='vierkant'] {
    aspect-ratio: var(--k-verhouding-vierkant);
  }

  .kader[data-verhouding='breed'] {
    aspect-ratio: var(--k-verhouding-breed);
  }

  .afbeelding {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .afbeelding {
      transition: scale var(--beweging-hover-beeld);
    }

    .beeld:hover .afbeelding {
      scale: var(--k-beweging-schaal-hover);
    }

    @supports (animation-timeline: view()) {
      [data-parallax] .afbeelding {
        animation: beeld-parallax linear both;
        animation-timeline: view();
      }
    }
  }

  @keyframes beeld-parallax {
    from {
      translate: 0 calc(var(--k-beweging-parallax-hoeveelheid) * -1);
    }
    to {
      translate: 0 var(--k-beweging-parallax-hoeveelheid);
    }
  }
</style>
