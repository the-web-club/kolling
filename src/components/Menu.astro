---
import { Picture } from 'astro:assets';
import woordmerk from '@/assets/merk/woordmerk.png';
import { haalInstellingen } from '@/lib/content';

const { naam, navigatie, telefoon, instagram } = await haalInstellingen();
const huidigPad = Astro.url.pathname;
---

<button
  class="menu-knop"
  type="button"
  popovertarget="menu"
  aria-expanded="false"
  data-menu-knop
  data-onthul="fade"
>
  Menu
</button>

<div class="menu" id="menu" popover data-menu>
  <div class="menu-kop">
    <div class="merk">
      <Picture src={woordmerk} formats={['avif', 'webp']} alt={naam} width={70} />
    </div>
    <button class="menu-sluiten" type="button" popovertarget="menu" popovertargetaction="hide">
      Sluiten
    </button>
  </div>

  <ul>
    {
      navigatie.map(({ label, pad }, plek) => (
        <li style={`--plek: ${plek}`}>
          <a href={pad} aria-current={huidigPad === pad ? 'page' : undefined}>
            {label}
            {huidigPad === pad && <span class="indicator" />}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="menu-voet">
    <a href={`tel:${telefoon.e164}`}>{telefoon.weergave}</a>
    <a href={instagram} rel="noopener">Instagram</a>
  </div>
</div>

<script>
  import '@/lib/menu';
</script>

<style>
  .menu-knop,
  .menu-sluiten {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--navigatie-aanraakdoel);
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--tekst-klein-familie);
    font-size: var(--navigatie-grootte);
    font-weight: var(--navigatie-gewicht);
    color: var(--navigatie-voorgrond);
    cursor: pointer;
  }

  .menu-knop,
  .menu-sluiten {
    grid-column: 4;
    justify-self: end;
    line-height: 1;
  }

  .menu-knop {
    --onthul-vertraging: var(--binnenkomst-kop);
  }

  /* De popover vult de breedte en is zo hoog als haar inhoud. Het dekkende
     papier zit op de backdrop, zodat een klik naast de lijst het menu sluit.
     De eigen kop draagt de bovenpadding, net als op de pagina zelf. */
  .menu {
    position: fixed;
    inset: 0 0 auto 0;
    inline-size: 100%;
    max-inline-size: var(--maat-container);
    margin-inline: auto;
    padding-inline: var(--pagina-padding);
    padding-block-end: var(--pagina-padding);
    border: 0;
    background-color: transparent;
    color: var(--kleur-voorgrond);
  }

  .menu:popover-open {
    display: grid;
    gap: var(--ruimte-rij-md);
    max-block-size: 100dvh;
    overflow-y: auto;
  }

  /* Hetzelfde raster, dezelfde hoogte en dezelfde padding als PaginaKop, zodat
     het woordmerk bij het openen van het menu op zijn plek blijft staan. */
  .menu-kop {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-rows: var(--merk-hoogte);
    align-items: center;
    column-gap: var(--kop-kolom-ruimte);
    padding-block: var(--kop-padding-blok);
  }

  .merk {
    display: flex;
    align-items: center;
    grid-column: 1;
    justify-self: start;
    line-height: 0;
  }

  .merk :global(picture),
  .merk :global(img) {
    display: block;
  }

  .merk :global(img) {
    block-size: var(--merk-hoogte);
    inline-size: auto;
    filter: var(--filter-woordmerk);
  }

  ul {
    display: grid;
    gap: var(--menu-ruimte);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    position: relative;
    display: flex;
    align-items: center;
    min-block-size: var(--navigatie-aanraakdoel);
    font-family: var(--menu-familie);
    font-size: var(--menu-grootte);
    font-weight: var(--menu-gewicht);
    line-height: var(--menu-regelhoogte);
    letter-spacing: var(--menu-spatiering);
  }

  .indicator {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: var(--navigatie-indicator-dikte);
    background-color: var(--navigatie-lijn-actief);
  }

  .menu-voet {
    display: flex;
    gap: var(--navigatie-ruimte);
    font-size: var(--tekst-klein-grootte);
  }

  .menu-voet a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--navigatie-aanraakdoel);
    color: var(--navigatie-voorgrond);
    text-decoration-line: underline;
  }

  @media (min-width: 48rem) {
    .menu {
      padding-inline: var(--pagina-padding-breed);
      padding-block-end: var(--pagina-padding-breed);
    }

    .menu-kop {
      grid-template-rows: var(--merk-hoogte-breed);
    }

    .merk :global(img) {
      block-size: var(--merk-hoogte-breed);
    }
  }

  @media (max-height: 37.5rem) {
    ul a {
      font-size: var(--menu-grootte-kort);
    }
  }

  /* Een liggende telefoon is te laag voor zes regels van 44 px. De lijst gaat
     daar in twee kolommen, in dezelfde leesrichting. */
  @media (max-height: 30rem) {
    ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .menu-knop {
      display: none;
    }
  }
</style>
