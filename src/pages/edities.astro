---
import CtaStrook from '@/components/CtaStrook.astro';
import EditieKaart from '@/components/EditieKaart.astro';
import SectieIntro from '@/components/SectieIntro.astro';
import TekstLink from '@/components/TekstLink.astro';
import Basis from '@/layouts/Basis.astro';
import { haalEdities } from '@/lib/content';

const edities = await haalEdities();
---

<Basis
  titel="Edities"
  beschrijving="Kolling werkt aan eigen ontwerpen in beperkte oplage. De collectie is nog in ontwikkeling. Laat weten dat je bericht wilt zodra er meer bekend is."
>
  <section>
    <SectieIntro label="Edities" kop="Eigen ontwerpen in beperkte oplage" niveau={1}>
      <p>
        Naast maatwerk werkt Thomas aan eigen ontwerpen die hij in een beperkte oplage maakt. Niet
        op aanvraag, maar als vast ontwerp dat een paar keer gemaakt wordt.
      </p>
      <p>
        De collectie is nog in ontwikkeling. Er is nog niets te koop, en er staan nog geen
        ontwerpen, oplages, prijzen of data vast.
      </p>
    </SectieIntro>
  </section>

  {
    edities.length === 0 ? (
      <section>
        <div class="aankondiging">
          <h2 class="kop">Wat je kunt verwachten</h2>
          <dl class="kenmerken">
            <dt>Vast ontwerp</dt>
            <dd>Geen maatwerk, maar een ontwerp dat af is en herhaald wordt gemaakt.</dd>
            <dt>Beperkte oplage</dt>
            <dd>Een vastgelegd aantal exemplaren, genummerd en met vermelding van het materiaal.</dd>
            <dt>Zelfde werkplaats</dt>
            <dd>Gemaakt aan de Strangeweg in Ommen, met dezelfde afwerking als het maatwerk.</dd>
          </dl>
          <p class="noot">
            Wil je bericht krijgen zodra de eerste editie klaar is, laat dat dan weten via het
            formulier. Kies bij soort aanvraag voor Editie.
          </p>
          <p>
            <TekstLink href="/contact?aanvraag=editie" variant="intekenend">
              Laat weten dat je bericht wilt
            </TekstLink>
          </p>
        </div>
      </section>
    ) : (
      <section>
        <div class="raster">
          {edities.map((editie) => (
            <div class="plek">
              <EditieKaart editie={editie} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <CtaStrook
    kop="Liever iets op maat"
    tekst="Maatwerk is er wel. Stuur je idee met de maten van je ruimte en je hoort wat er mogelijk is."
    aanvraag="editie"
  />
</Basis>

<style>
  .aankondiging {
    display: grid;
    gap: var(--ruimte-stapel-lg);
    grid-column: 1 / -1;
  }

  .kop {
    font-size: var(--tekst-kop3-grootte);
    letter-spacing: var(--tekst-kop3-spatiering);
  }

  .kenmerken {
    display: grid;
    gap: var(--ruimte-stapel-sm);
    margin: 0;
  }

  .kenmerken dt {
    font-size: var(--tekst-label-grootte);
    font-weight: var(--tekst-label-gewicht);
    letter-spacing: var(--tekst-label-spatiering);
    text-transform: uppercase;
    color: var(--kleur-voorgrond-subtiel);
  }

  .kenmerken dd {
    margin: 0;
    padding-block-end: var(--ruimte-stapel-md);
    color: var(--kleur-voorgrond-gedempt);
    border-block-end: var(--k-rand-haarlijn) solid var(--kleur-lijn);
  }

  .noot {
    color: var(--kleur-voorgrond-gedempt);
  }

  .raster {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--ruimte-rij-lg) var(--ruimte-goot);
  }

  .plek {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .aankondiging {
      grid-column: 2 / span 7;
    }

    .plek {
      grid-column: span 6;
    }
  }
</style>
