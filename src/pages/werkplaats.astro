---
import Beeld from '@/components/Beeld.astro';
import CtaStrook from '@/components/CtaStrook.astro';
import MateriaalLijst from '@/components/MateriaalLijst.astro';
import SectieIntro from '@/components/SectieIntro.astro';
import TekstLink from '@/components/TekstLink.astro';
import Basis from '@/layouts/Basis.astro';
import { haalInstellingen } from '@/lib/content';

const instellingen = await haalInstellingen();

const WERKWIJZE = [
  'Eén maker van eerste gesprek tot plaatsing',
  'Massief hout waar het kan, plaatmateriaal waar het moet',
  'Inmeten op locatie bij inbouwwerk',
  'Afwerken in de werkplaats, niet bij jou thuis',
];

const BEELDEN = [
  {
    alt: 'De werkbank in de werkplaats aan de Strangeweg, met gereedschap binnen handbereik',
    plaatshouder: { tint: 'noten', label: 'Beeld volgt' },
    verhouding: 'liggend',
  },
  {
    alt: 'Thomas Kolling aan het werk aan een tafelblad',
    plaatshouder: { tint: 'eik', label: 'Beeld volgt' },
    verhouding: 'staand',
  },
] as const;
---

<Basis
  titel="De werkplaats"
  beschrijving="Thomas Kolling werkt aan de Strangeweg in Ommen. Alles wordt daar gemaakt en afgewerkt. Je kunt op afspraak langskomen om het hout te zien."
>
  <section>
    <SectieIntro label="Werkplaats" kop="Eén maker, één werkplaats" niveau={1}>
      <p>
        Kolling is het werk van Thomas Kolling. Hij maakt meubels en houtwerk op maat in zijn eigen
        werkplaats aan de Strangeweg in Ommen.
      </p>
      <p>
        Dat betekent dat je met één persoon te maken hebt. Degene die je idee hoort, is ook degene
        die het maakt en het bij je plaatst.
      </p>
    </SectieIntro>
    <div class="beeld">
      <Beeld beeld={BEELDEN[0]} prioriteit parallax onthul={false} />
    </div>
  </section>

  <section>
    <div class="portret">
      <Beeld beeld={BEELDEN[1]} />
    </div>
    <div class="uitleg">
      <h2>Hoe er gewerkt wordt</h2>
      <p>
        Het meeste werk begint bij een ruimte die niet standaard is. Een schuine wand, een nis, een
        hoogte die niet klopt. Daar is maatwerk voor.
      </p>
      <p>
        Wat in de werkplaats wordt gemaakt, wordt daar ook afgewerkt. Dat scheelt stof en tijd bij
        je thuis, en het eindresultaat is beter te beheersen.
      </p>
      <MateriaalLijst kop="Werkwijze" items={WERKWIJZE} />
    </div>
  </section>

  <section>
    <SectieIntro label="Bezoek" kop="Langskomen in Ommen">
      <p>
        {instellingen.bezoek} Je ziet dan het hout dat beschikbaar is, en je kunt maten en foto&rsquo;s
        van je ruimte meenemen.
      </p>
      <p>
        Adres: {instellingen.adres.straat}, {instellingen.adres.postcode}
        {' '}{instellingen.adres.plaats}. Telefoon:{' '}
        <TekstLink href={`tel:${instellingen.telefoon.e164}`}>
          {instellingen.telefoon.weergave}
        </TekstLink>.
      </p>
      <p>
        <TekstLink href="/werkgebied/ommen" variant="intekenend">
          Meer over de werkplaats in Ommen
        </TekstLink>
      </p>
    </SectieIntro>
  </section>

  <CtaStrook
    kop="Bespreek je idee"
    tekst="Stuur je idee met maten en foto's van de ruimte. Je hoort binnen twee werkdagen wat er mogelijk is."
  />
</Basis>

<style>
  .beeld,
  .portret,
  .uitleg {
    grid-column: 1 / -1;
  }

  .uitleg {
    display: grid;
    gap: var(--ruimte-stapel-lg);
    align-content: start;
  }

  @media (min-width: 64rem) {
    .portret {
      grid-column: 1 / span 5;
    }

    .uitleg {
      grid-column: 7 / span 6;
    }
  }
</style>
