---
import CtaStrook from '@/components/CtaStrook.astro';
import Faq from '@/components/Faq.astro';
import JsonLd from '@/components/JsonLd.astro';
import MateriaalLijst from '@/components/MateriaalLijst.astro';
import ProcesStappen from '@/components/ProcesStappen.astro';
import SectieIntro from '@/components/SectieIntro.astro';
import TekstLink from '@/components/TekstLink.astro';
import Basis from '@/layouts/Basis.astro';
import { haalInstellingen, haalLocaties, haalVragenVoor } from '@/lib/content';
import { maakVragenpagina } from '@/lib/jsonld';

const instellingen = await haalInstellingen();
const locaties = await haalLocaties();
const vragen = (await haalVragenVoor('/werkgebied')).map((item) => item.data);

const LANDELIJK = [
  {
    kop: 'Inmeten',
    tekst: 'Bij inbouwwerk komt Thomas inmeten, ook buiten de regio. Dat is één bezoek dat de maatvoering vastlegt.',
  },
  {
    kop: 'Maken in Ommen',
    tekst: 'Het werk wordt altijd in de werkplaats in Ommen gemaakt en daar compleet afgewerkt.',
  },
  {
    kop: 'Transport',
    tekst: 'Het werk wordt zelf vervoerd, zodat er niets beschadigd aankomt en er niets hoeft te worden ingepakt voor een vervoerder.',
  },
  {
    kop: 'Plaatsen',
    tekst: 'Losse meubels worden geleverd en gezet. Inbouwwerk wordt ter plekke gesteld en afgewerkt.',
  },
];

const AANDACHT = [
  'Bij inbouwwerk hoort altijd een bezoek om in te meten',
  'Losse meubels kunnen zonder bezoek, op basis van maten en foto\u2019s',
  'Grote delen worden in de werkplaats voorgemonteerd en op locatie gesteld',
  'Reistijd en transport horen bij het voorstel, niet bij de verrassingen achteraf',
];
---

<Basis
  titel="Werkgebied"
  beschrijving="De werkplaats staat in Ommen en Kolling werkt door heel Nederland. Zo verlopen inmeten, transport en montage buiten de eigen regio."
>
  <JsonLd schema={maakVragenpagina(vragen)} slot="hoofd" />

  <section>
    <SectieIntro label="Werkgebied" kop="Gemaakt in Ommen, geplaatst in heel Nederland" niveau={1}>
      <p>
        Er is één werkplaats, en die staat in {instellingen.adres.plaats}. Daar wordt alles gemaakt.
        Opdrachten voeren we door heel Nederland uit.
      </p>
      <p>
        Er zijn geen andere vestigingen en geen vaste onderaannemers in andere plaatsen. Wat je
        hieronder leest, geldt dus voor elke opdracht buiten de regio.
      </p>
    </SectieIntro>
  </section>

  <section>
    <SectieIntro label="Praktisch" kop="Hoe een opdracht op afstand verloopt" />
    <ProcesStappen stappen={LANDELIJK} />
  </section>

  <section>
    <SectieIntro label="Aandachtspunten" kop="Wat dat voor je betekent">
      <p>
        Afstand verandert niets aan de uitvoering, wel aan de planning. Een extra rit om in te meten
        vraagt een dag die ingepland moet worden.
      </p>
    </SectieIntro>
    <div class="lijst">
      <MateriaalLijst kop="Goed om te weten" items={AANDACHT} />
    </div>
  </section>

  <section>
    <SectieIntro label="Regio" kop="De werkplaats zelf">
      <p>
        Woon je in de omgeving van Ommen, dan is langskomen de snelste route. Op die pagina staat
        wat je kunt verwachten.
      </p>
    </SectieIntro>
    <ul class="locaties">
      {
        locaties.map((locatie) => (
          <li>
            <TekstLink href={`/werkgebied/${locatie.id}`} variant="intekenend">
              Meubelmaker in {locatie.data.plaats}
            </TekstLink>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <SectieIntro label="Vragen" kop="Vragen over werken op afstand" />
    <div class="vragen">
      <Faq vragen={vragen} />
    </div>
  </section>

  <CtaStrook
    kop="Bespreek je idee"
    tekst="Vertel waar je zit en wat je nodig hebt. Je hoort binnen twee werkdagen wat er mogelijk is."
  />
</Basis>

<style>
  .lijst,
  .vragen,
  .locaties {
    grid-column: 1 / -1;
  }

  .locaties {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--tekst-kop4-grootte);
  }

  @media (min-width: 64rem) {
    .lijst {
      grid-column: 2 / span 6;
    }

    .vragen {
      grid-column: 2 / span 8;
    }
  }
</style>
