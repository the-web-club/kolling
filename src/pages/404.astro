---
import Basis from '@/layouts/Basis.astro';
import { haalInstellingen } from '@/lib/content';

const instellingen = await haalInstellingen();
---

<Basis
  titel="Pagina niet gevonden"
  beschrijving="Deze pagina bestaat niet. Kolling maakt houtwerken en meubels op maat in eigen werkplaats in Ommen."
  indexeerbaar={false}
>
  <div class="pagina">
    <main class="statement">
      <h1>
        <span class="regel" data-onthul-regel><span>Deze pagina</span></span>
        <span class="regel" data-onthul-regel><span>bestaat niet.</span></span>
      </h1>
      <p class="intro" data-onthul="omhoog">
        Er staat op dit moment nog maar één pagina. Daar lees je waar Kolling aan werkt.
      </p>
      <p class="terug" data-onthul="omhoog">
        <a class="schakel" href="/">Naar de voorpagina</a>
      </p>
    </main>

    <footer class="voet" data-onthul="fade">
      <p>{instellingen.naam}, {instellingen.adres.plaats}</p>
    </footer>
  </div>
</Basis>

<style>
  .pagina {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--ruimte-rij-md);
    block-size: 100dvh;
    inline-size: 100%;
    max-inline-size: var(--maat-container);
    margin-inline: auto;
    padding: var(--pagina-padding);
  }

  .statement {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--ruimte-stapel-lg) var(--ruimte-goot);
    align-content: center;
  }

  h1 {
    grid-column: 1 / -1;
    font-size: var(--tekst-kop1-grootte);
    line-height: var(--tekst-kop1-regelhoogte);
    letter-spacing: var(--tekst-kop1-spatiering);
  }

  .regel:first-of-type > span {
    --onthul-vertraging: var(--binnenkomst-regel-een);
  }

  .regel:last-of-type > span {
    --onthul-vertraging: var(--binnenkomst-regel-twee);
  }

  .intro {
    --onthul-vertraging: var(--binnenkomst-intro);
    grid-column: 1 / -1;
    font-size: var(--tekst-intro-grootte);
    line-height: var(--tekst-intro-regelhoogte);
    color: var(--kleur-voorgrond-gedempt);
  }

  .terug {
    --onthul-vertraging: var(--binnenkomst-blok-een);
    grid-column: 1 / -1;
  }

  .schakel {
    display: inline-block;
    background-image: linear-gradient(var(--kleur-voorgrond), var(--kleur-voorgrond));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% var(--link-onderstreping-dikte);
    padding-block-end: var(--link-onderstreping-afstand);
  }

  .voet p {
    max-inline-size: none;
  }

  .voet {
    --onthul-vertraging: var(--binnenkomst-micro);
    position: relative;
    padding-block-start: var(--ruimte-stapel-md);
    font-size: var(--tekst-label-grootte);
    text-align: end;
    color: var(--kleur-voorgrond-subtiel);
  }

  /* Dezelfde doorlopende haarlijn als op de voorpagina. */
  .voet::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: calc(50% - 50vw);
    inline-size: 100vw;
    block-size: var(--k-rand-haarlijn);
    background-color: var(--kleur-lijn);
  }

  @media (min-width: 48rem) {
    .pagina {
      padding: var(--pagina-padding-breed);
    }

    h1,
    .intro,
    .terug {
      grid-column: 2 / span 8;
    }
  }

  @media (max-height: 44rem) {
    h1 {
      font-size: var(--tekst-kop2-grootte);
      line-height: var(--tekst-kop2-regelhoogte);
    }

    .intro {
      font-size: var(--tekst-lopend-grootte);
    }
  }

  @media (max-height: 30rem) {
    h1 {
      font-size: var(--tekst-kop3-grootte);
    }

    .intro {
      font-size: var(--tekst-klein-grootte);
    }
  }
</style>
