---
import dressoir from '@/assets/beelden/coming-soon/dressoir.jpg';
import planken from '@/assets/beelden/coming-soon/planken.jpg';
import Beeld from '@/components/Beeld.astro';
import Contactrij from '@/components/Contactrij.astro';
import PaginaKop from '@/components/PaginaKop.astro';
import Basis from '@/layouts/Basis.astro';
import { maakBronnen } from '@/lib/beeld';
import { paginaovergang } from '@/lib/beweging/paginaovergang';

const titel = 'Kolling, houtwerken en meubels uit Ommen';
const beschrijving =
  'Houtwerken en meubels op maat, gemaakt in eigen werkplaats in Ommen. De website volgt; een idee bespreken kan nu al via 06 13 62 22 76.';

const statement = ['Houtwerken & meubels', 'uit Ommen.'];
const intro =
  'Op maat gemaakt in eigen werkplaats aan de Strangeweg. De website volgt. Een idee bespreken kan nu al.';

const MATEN_GROOT = '(min-width: 1024px) 34vw, 100vw';
const MATEN_KLEIN = '16vw';
const BREEDTES_KLEIN = [320, 480];

// De pagina heeft de bronnen zelf nodig voor de preload van het dressoir en
// voor de beeldenlijst in de JSON-LD. Astro maakt van een gelijke transformatie
// hetzelfde bestand, dus het beeldcomponent levert geen tweede variant op.
// Van onderen uitsnijden houdt het hele dressoir in beeld, met de poten en de
// vloer; wat wegvalt is de bovenkant van de wand.
const bronnenGroot = await maakBronnen({
  beeld: dressoir,
  verhouding: 'liggend',
  positie: 'bottom',
});
const bronnenKlein = await maakBronnen({
  beeld: planken,
  verhouding: 'vierkant',
  breedtes: BREEDTES_KLEIN,
});
---

<Basis
  titel={titel}
  beschrijving={beschrijving}
  suffix={false}
  jsonLd
  beelden={[bronnenGroot.jpeg.src, bronnenKlein.jpeg.src]}
  voorlaadBeeld={{ srcset: bronnenGroot.avif.srcset, maten: MATEN_GROOT }}
>
  <div class="pagina">
    <PaginaKop />

    <main class="statement" transition:name="statement" transition:animate={paginaovergang}>
      <Beeld
        class="beeld-groot"
        beeld={dressoir}
        alt="Dressoir met geprofileerde houten schuifdeuren, een hand zet er een houten schaal op"
        verhouding="liggend"
        positie="bottom"
        maten={MATEN_GROOT}
        bijschrift="Dressoir, uit de werkplaats"
        prioriteit
      />

      <h1>
        {
          statement.map((regel) => (
            <span class="regel" data-onthul-regel>
              <span>{regel}</span>
            </span>
          ))
        }
      </h1>
      <p class="intro" data-onthul="omhoog">{intro}</p>

      <Beeld
        class="beeld-klein"
        beeld={planken}
        alt="Gestapelde boomstamplanken met schors"
        verhouding="vierkant"
        breedtes={BREEDTES_KLEIN}
        maten={MATEN_KLEIN}
        bijschrift="Boomstamplanken"
      />
    </main>

    <Contactrij />
  </div>
</Basis>

<style>
  .statement {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--ruimte-stapel-lg) var(--ruimte-goot);
    align-content: center;
    min-inline-size: 0;
  }

  /* De kop staat op twee expliciete blokken. De bovengrens is de kolombreedte
     (cqi), niet de viewport: voorbij 90rem groeit het raster niet meer mee,
     een vw-maat wel. Een regel die toch te breed is, breekt af. */
  h1 {
    --cap: var(--statement-cap);
    grid-column: 1 / -1;
    min-inline-size: 0;
    font-size: min(var(--tekst-display-grootte), var(--cap));
    line-height: var(--tekst-display-regelhoogte);
    letter-spacing: var(--tekst-display-spatiering);
    overflow-wrap: anywhere;
  }

  .regel:first-child > span {
    --onthul-vertraging: var(--binnenkomst-regel-een);
  }

  .regel:last-child > span {
    --onthul-vertraging: var(--binnenkomst-regel-twee);
  }

  .intro {
    --onthul-vertraging: var(--binnenkomst-intro);
    grid-column: 1 / -1;
    font-size: var(--tekst-intro-grootte);
    line-height: var(--tekst-intro-regelhoogte);
    color: var(--kleur-voorgrond-gedempt);
  }

  /* De beelden komen uit een component, dus hun klassen staan buiten het bereik
     van de scoped CSS van deze pagina. Het pad erheen blijft beperkt tot de
     middelste rij.

     Het dressoir is tot 1024 px een band over de volle breedte boven het
     statement; de planken staan daar niet. */
  .statement :global(.beeld-groot) {
    --beeld-vertraging: var(--binnenkomst-beeld-groot);
    --beeld-max-hoogte: var(--beeld-band-hoogte);
    grid-column: 1 / -1;
  }

  .statement :global(.beeld-klein) {
    display: none;
  }

  /* De band krijgt de hoogte die na kop en intro overblijft, met de bandhoogte
     als bovengrens. Daarmee kan hij de pagina niet langer maken dan het scherm,
     hoe vaak de tekst ook afbreekt. De container is de zichtbare hoogte, niet
     de layoutviewport. De negatieve marge heft de rijafstand van de pagina op,
     zodat de band de kop raakt. */
  @container scherm (max-width: 1023.98px) and (min-height: 481px) {
    .statement {
      grid-template-rows: minmax(0, 1fr) auto auto;
      min-block-size: 0;
      margin-block-start: calc(-1 * var(--ruimte-rij-md));
    }

    /* Zonder min-block-size: 0 houdt de automatische minimumhoogte van een
       rasteritem het kader op zijn volle maat en loopt de pagina over. De
       vrije hoogte valt in de derde rij, onder het bijschrift, anders ontstaat
       er ruimte tussen de foto en het bijschrift. */
    .statement :global(.beeld-groot) {
      grid-row: 1;
      grid-template-rows: auto auto minmax(0, 1fr);
      min-block-size: 0;
    }

    /* De verhouding bepaalt de uitsnede, niet de rijhoogte. Anders rekent het
       raster de volle 3:2 en blijft er ruimte over onder de afgekapte foto. */
    .statement :global(.beeld-groot > picture) {
      --beeld-verhouding-liggend: auto;
      block-size: var(--beeld-max-hoogte);
      min-block-size: 0;
      max-block-size: var(--beeld-max-hoogte);
    }
  }

  /* Op een telefoon loopt de foto tot de schermrand. Het bijschrift blijft in
     de kolom, op de padding van de pagina. */
  @container scherm (max-width: 767.98px) and (min-height: 481px) {
    .statement :global(.beeld-groot > picture) {
      inline-size: calc(100% + 2 * var(--pagina-padding));
      max-inline-size: none;
      margin-inline: calc(-1 * var(--pagina-padding));
    }
  }

  /* Een staande telefoon meet met de browserbalk vaak onder 780 px. De band
     hoort daar wel. Alleen een liggend scherm is te laag. In de rechterkolom
     kost het beeld geen hoogte; daar is 512 px de ondergrens. */
  @container scherm (max-width: 1023.98px) and (max-height: 480px) {
    .statement :global(.beeld-groot) {
      display: none;
    }
  }

  @container scherm (min-width: 1024px) and (max-height: 511px) {
    .statement :global(.beeld-groot) {
      display: none;
    }
  }

  @media (min-width: 768px) {
    h1 {
      --cap: var(--statement-cap-breed);
      grid-column: 2 / span 10;
    }

    .intro {
      grid-column: 2 / span 8;
    }

    .statement :global(.beeld-groot) {
      --beeld-max-hoogte: var(--beeld-band-hoogte-breed);
    }
  }

  /* Vanaf 1024 px staat het statement op de linkerhelft en het dressoir in de
     rechterkolom, met de hoogte van de middelste rij als bovengrens. */
  @media (min-width: 1024px) {
    .statement {
      grid-template-rows: auto 1fr auto;
    }

    h1 {
      --cap: var(--statement-cap-naast-beeld);
      grid-column: 2 / span 6;
      grid-row: 1;
    }

    .intro {
      grid-column: 2 / span 6;
      grid-row: 2;
      align-self: start;
      max-inline-size: var(--statement-introbreedte);
    }

    .statement :global(.beeld-groot) {
      --beeld-max-hoogte: var(--beeld-hoogte-kolom);
      grid-column: 9 / span 4;
      grid-row: 1 / -1;
      align-self: end;
      margin-block-end: var(--beeld-rand-onder);
    }
  }

  /* Subgrid houdt beide randen van de planken op een rasterlijn: het beeld op
     kolom 2 en 3, het bijschrift op 4 en 5. */
  @container scherm (min-width: 1024px) and (min-height: 820px) {
    .statement :global(.beeld-klein) {
      --beeld-vertraging: var(--binnenkomst-beeld-klein);
      display: grid;
      grid-column: 2 / span 4;
      grid-row: 3;
      grid-template-columns: subgrid;
      align-items: end;
      margin-block-end: var(--beeld-rand-onder);
    }

    .statement :global(.beeld-klein > picture),
    .statement :global(.beeld-klein > .bijschrift) {
      grid-column: span 2;
    }
  }

  /* Korte schermen: typografie en afstanden één stap kleiner, zodat de pagina
     nooit hoeft te scrollen. De tweede stap vangt een liggende telefoon op. */
  @container scherm (max-height: 704px) {
    h1 {
      font-size: min(var(--tekst-display-kort-grootte), var(--cap));
      line-height: var(--tekst-display-kort-regelhoogte);
      letter-spacing: var(--tekst-display-kort-spatiering);
    }

    .intro {
      font-size: var(--tekst-lopend-grootte);
    }

    .statement {
      gap: var(--ruimte-stapel-md) var(--ruimte-goot);
    }
  }

  @container scherm (max-height: 480px) {
    h1 {
      font-size: min(var(--tekst-kop3-grootte), var(--cap));
      line-height: var(--tekst-kop3-regelhoogte);
      letter-spacing: var(--tekst-kop3-spatiering);
    }

    .intro {
      font-size: var(--tekst-klein-grootte);
    }

    .statement {
      gap: var(--ruimte-stapel-sm) var(--ruimte-goot);
    }
  }
</style>
