---
import Contactrij from '@/components/Contactrij.astro';
import PaginaKop from '@/components/PaginaKop.astro';
import Basis from '@/layouts/Basis.astro';
import { paginaovergang } from '@/lib/beweging/paginaovergang';

const titel = 'Kolling, houtwerken en meubels uit Ommen';
const beschrijving =
  'Houtwerken en meubels op maat, gemaakt in eigen werkplaats in Ommen. De website volgt; een idee bespreken kan nu al via 06 13 62 22 76.';

const statement = ['Houtwerken & meubels', 'uit Ommen.'];
const intro =
  'Op maat gemaakt in eigen werkplaats aan de Strangeweg. De website volgt. Een idee bespreken kan nu al.';
---

<Basis titel={titel} beschrijving={beschrijving} suffix={false} jsonLd>
  <div class="pagina">
    <PaginaKop />

    <main class="statement" transition:name="statement" transition:animate={paginaovergang}>
      <h1>
        {
          statement.map((regel) => (
            <span class="regel" data-onthul-regel>
              <span>{regel}</span>
            </span>
          ))
        }
      </h1>
      <p class="intro" data-onthul="omhoog">{intro}</p>
    </main>

    <Contactrij />
  </div>
</Basis>

<style>
  .statement {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--ruimte-stapel-lg) var(--ruimte-goot);
    align-content: center;
  }

  /* De kop staat op twee regels die niet mogen afbreken. De bovengrens is
     daarom de kolombreedte (cqi), niet de viewport: voorbij 90rem groeit het
     raster niet meer mee, een vw-maat wel. */
  h1 {
    --cap: var(--statement-cap);
    grid-column: 1 / -1;
    font-size: min(var(--tekst-display-grootte), var(--cap));
    line-height: var(--tekst-display-regelhoogte);
    letter-spacing: var(--tekst-display-spatiering);
    text-wrap: nowrap;
  }

  .regel:first-child > span {
    --onthul-vertraging: var(--binnenkomst-regel-een);
  }

  .regel:last-child > span {
    --onthul-vertraging: var(--binnenkomst-regel-twee);
  }

  .intro {
    --onthul-vertraging: var(--binnenkomst-intro);
    grid-column: 1 / -1;
    font-size: var(--tekst-intro-grootte);
    line-height: var(--tekst-intro-regelhoogte);
    color: var(--kleur-voorgrond-gedempt);
  }

  @media (min-width: 48rem) {
    h1 {
      --cap: var(--statement-cap-breed);
      grid-column: 2 / span 10;
    }

    .intro {
      grid-column: 2 / span 8;
    }
  }

  /* Korte schermen: typografie en afstanden één stap kleiner, zodat de pagina
     nooit hoeft te scrollen. De tweede stap vangt een liggende telefoon op. */
  @media (max-height: 44rem) {
    h1 {
      font-size: min(var(--tekst-display-kort-grootte), var(--cap));
      line-height: var(--tekst-display-kort-regelhoogte);
      letter-spacing: var(--tekst-display-kort-spatiering);
    }

    .intro {
      font-size: var(--tekst-lopend-grootte);
    }

    .statement {
      gap: var(--ruimte-stapel-md) var(--ruimte-goot);
    }
  }

  @media (max-height: 30rem) {
    h1 {
      font-size: min(var(--tekst-kop3-grootte), var(--cap));
      line-height: var(--tekst-kop3-regelhoogte);
      letter-spacing: var(--tekst-kop3-spatiering);
    }

    .intro {
      font-size: var(--tekst-klein-grootte);
    }

    .statement {
      gap: var(--ruimte-stapel-sm) var(--ruimte-goot);
    }
  }
</style>
