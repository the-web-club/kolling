---
import { Picture } from 'astro:assets';
import woordmerk from '@/assets/merk/woordmerk.png';
import Basis from '@/layouts/Basis.astro';
import { haalInstellingen, isBekend } from '@/lib/content';

const instellingen = await haalInstellingen();
const { adres, telefoon } = instellingen;

const titel = 'Kolling, houten maatwerk uit Ommen';
const beschrijving =
  'Meubels en houtwerk op maat, gemaakt in eigen werkplaats in Ommen. De website volgt; een idee bespreken kan nu al via 06 13 62 22 76.';

const statement = ['Houten maatwerk', 'uit Ommen.'];
const intro =
  'Meubels en houtwerk op maat, gemaakt in eigen werkplaats aan de Strangeweg. De website volgt. Een idee bespreken kan nu al.';

const heeftEmail = isBekend(instellingen.email);
const heeftKvk = isBekend(instellingen.kvk);
---

<Basis titel={titel} beschrijving={beschrijving} suffix={false}>
  <div class="pagina">
    <header class="kop">
      <div class="merk" data-onthul="fade">
        <Picture
          src={woordmerk}
          formats={['avif', 'webp']}
          alt={instellingen.naam}
          width={56}
          height={28}
          densities={[2]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <p class="plaats" data-onthul="fade">
        {adres.plaats}<time data-klok></time>
      </p>
    </header>

    <main class="statement">
      <h1>
        {
          statement.map((regel) => (
            <span class="regel" data-onthul-regel>
              <span>{regel}</span>
            </span>
          ))
        }
      </h1>
      <p class="intro" data-onthul="omhoog">{intro}</p>
    </main>

    <footer class="contact">
      <div class="lijn" data-onthul="lijn"></div>

      <div class="blokken">
        <div class="blok" data-onthul="omhoog">
          <h2 class="label">Werkplaats</h2>
          <address>
            {adres.straat}, {adres.postcode}
            {adres.plaats}<br />
            Bezoek op afspraak
          </address>
        </div>

        <div class="blok" data-onthul="omhoog">
          <h2 class="label">{instellingen.cta.primair}</h2>
          <p>
            <a class="schakel" href={`tel:${telefoon.e164}`}>{telefoon.weergave}</a>
            {
              heeftEmail && (
                <a class="schakel" href={`mailto:${instellingen.email}`}>
                  {instellingen.email}
                </a>
              )
            }
          </p>
        </div>

        <div class="blok" data-onthul="omhoog">
          <h2 class="label">Volg het werk</h2>
          <p>
            <a class="schakel" href={instellingen.instagram} rel="noopener">Instagram</a>
          </p>
        </div>
      </div>

      <p class="micro" data-onthul="fade">
        {instellingen.naam}, {adres.plaats}{heeftKvk && `, KvK ${instellingen.kvk}`}
      </p>
    </footer>
  </div>
</Basis>

<script is:inline>
  const klok = document.querySelector('[data-klok]');
  if (klok) {
    const opmaak = new Intl.DateTimeFormat('nl-NL', {
      timeZone: 'Europe/Amsterdam',
      hour: '2-digit',
      minute: '2-digit',
    });
    const zetTijd = () => {
      const nu = new Date();
      klok.dateTime = nu.toISOString();
      klok.textContent = `, ${opmaak.format(nu)}`;
    };
    zetTijd();
    setInterval(zetTijd, 60000);
  }
</script>

<style>
  .pagina {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--ruimte-rij-md);
    block-size: 100dvh;
    inline-size: 100%;
    max-inline-size: var(--maat-container);
    margin-inline: auto;
    padding: var(--ruimte-goot);
  }

  .kop {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ruimte-stapel-md);
  }

  .merk {
    --onthul-vertraging: var(--binnenkomst-kop);
  }

  .merk :global(img) {
    display: block;
    block-size: var(--merk-hoogte);
    inline-size: auto;
  }

  .plaats {
    --onthul-vertraging: var(--binnenkomst-kop);
    font-size: var(--tekst-klein-grootte);
    font-variant-numeric: tabular-nums;
    color: var(--kleur-voorgrond-gedempt);
  }

  .statement {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--ruimte-stapel-lg) var(--ruimte-goot);
    align-content: center;
  }

  h1 {
    grid-column: 1 / -1;
    font-size: var(--tekst-display-grootte);
    line-height: var(--tekst-display-regelhoogte);
    letter-spacing: var(--tekst-display-spatiering);
  }

  .regel:first-child > span {
    --onthul-vertraging: var(--binnenkomst-regel-een);
  }

  .regel:last-child > span {
    --onthul-vertraging: var(--binnenkomst-regel-twee);
  }

  .intro {
    --onthul-vertraging: var(--binnenkomst-intro);
    grid-column: 1 / -1;
    font-size: var(--tekst-intro-grootte);
    line-height: var(--tekst-intro-regelhoogte);
    color: var(--kleur-voorgrond-gedempt);
  }

  .contact {
    display: grid;
    gap: var(--ruimte-4);
  }

  .lijn {
    --onthul-vertraging: var(--binnenkomst-lijn);
    block-size: var(--k-rand-haarlijn);
    background-color: var(--kleur-lijn);
  }

  .blokken {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--ruimte-4) var(--ruimte-goot);
  }

  .blok {
    display: grid;
    gap: var(--ruimte-stapel-sm);
    grid-column: 1 / -1;
    align-content: start;
    font-size: var(--tekst-klein-grootte);
    line-height: var(--tekst-lopend-regelhoogte);
  }

  .blok:nth-child(1) {
    --onthul-vertraging: var(--binnenkomst-blok-een);
  }

  .blok:nth-child(2) {
    --onthul-vertraging: var(--binnenkomst-blok-twee);
  }

  .blok:nth-child(3) {
    --onthul-vertraging: var(--binnenkomst-blok-drie);
  }

  .label {
    font-family: var(--tekst-lopend-familie);
    font-size: var(--tekst-label-grootte);
    font-weight: var(--tekst-label-gewicht);
    letter-spacing: var(--tekst-label-spatiering);
    text-transform: uppercase;
    color: var(--kleur-voorgrond-subtiel);
  }

  .schakel {
    display: inline-block;
    background-image: linear-gradient(var(--kleur-voorgrond), var(--kleur-voorgrond));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 var(--link-onderstreping-dikte);
    padding-block-end: var(--link-onderstreping-afstand);
  }

  .micro {
    --onthul-vertraging: var(--binnenkomst-micro);
    max-inline-size: none;
    font-size: var(--tekst-label-grootte);
    text-align: end;
    color: var(--kleur-voorgrond-subtiel);
  }

  @media (hover: hover) and (pointer: fine) {
    .schakel {
      transition: background-size var(--beweging-hover);
    }

    .schakel:hover {
      background-size: 100% var(--link-onderstreping-dikte);
    }
  }

  @media (min-width: 48rem) {
    .merk :global(img) {
      block-size: var(--merk-hoogte-breed);
    }

    h1,
    .intro {
      grid-column: 2 / span 8;
    }

    .blok:nth-child(1) {
      grid-column: 2 / span 3;
    }

    .blok:nth-child(2) {
      grid-column: 5 / span 3;
    }

    .blok:nth-child(3) {
      grid-column: 8 / span 3;
    }
  }

  /* Korte schermen: typografie en afstanden één stap kleiner, zodat de pagina
     nooit hoeft te scrollen. De tweede stap vangt een liggende telefoon op. */
  @media (max-height: 44rem) {
    .pagina {
      gap: var(--ruimte-stapel-md);
    }

    h1 {
      font-size: var(--tekst-display-kort-grootte);
      line-height: var(--tekst-display-kort-regelhoogte);
      letter-spacing: var(--tekst-display-kort-spatiering);
    }

    .intro {
      font-size: var(--tekst-lopend-grootte);
    }

    .statement {
      gap: var(--ruimte-stapel-md) var(--ruimte-goot);
    }
  }

  @media (max-height: 30rem) {
    h1 {
      font-size: var(--tekst-kop3-grootte);
      line-height: var(--tekst-kop3-regelhoogte);
      letter-spacing: var(--tekst-kop3-spatiering);
    }

    .intro {
      font-size: var(--tekst-klein-grootte);
    }

    .statement {
      gap: var(--ruimte-stapel-sm) var(--ruimte-goot);
    }

    .contact,
    .blokken {
      gap: var(--ruimte-stapel-sm) var(--ruimte-goot);
    }
  }
</style>
