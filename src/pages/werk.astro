---
import CtaStrook from '@/components/CtaStrook.astro';
import SectieIntro from '@/components/SectieIntro.astro';
import TekstLink from '@/components/TekstLink.astro';
import WerkRaster from '@/components/WerkRaster.astro';
import Basis from '@/layouts/Basis.astro';
import { haalDiensten, haalProjecten } from '@/lib/content';

const projecten = await haalProjecten();
const diensten = await haalDiensten();
const heeftPlaatshouders = projecten.some((project) => project.data.plaatshouder);
---

<Basis
  titel="Werk"
  beschrijving="Een overzicht van het werk dat Kolling maakt: tafels, kasten, interieur en bijzonder houtwerk uit de eigen werkplaats in Ommen."
>
  <section>
    <SectieIntro label="Werk" kop="Werk uit de werkplaats" niveau={1}>
      <p>
        Werk is hier per stuk gemaakt, dus geen twee projecten zijn gelijk. Hieronder staat wat er
        uit de werkplaats komt, met per project het materiaal en de maatvoering.
      </p>
      {
        heeftPlaatshouders && (
          <p class="aanduiding">
            De beelden zijn nog impressies. Eigen projectfoto&rsquo;s volgen zodra het werk
            gefotografeerd is.
          </p>
        )
      }
    </SectieIntro>
  </section>

  <section>
    <WerkRaster projecten={projecten} />
  </section>

  <section>
    <SectieIntro label="Per soort werk" kop="Waar je werk onder valt">
      <p>
        Zoek je informatie over een bepaald soort werk, dan vind je per categorie de mogelijkheden,
        het proces en de meestgestelde vragen.
      </p>
    </SectieIntro>
    <ul class="soorten">
      {
        diensten.map((dienst) => (
          <li>
            <TekstLink href={`/maatwerk/${dienst.id}`} variant="intekenend">
              {dienst.data.titel}
            </TekstLink>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaStrook
    kop="Iets in gedachten"
    tekst="Stuur je idee met maten en foto's van de ruimte. Je hoort binnen twee werkdagen wat er mogelijk is."
  />
</Basis>

<style>
  .aanduiding {
    font-size: var(--tekst-klein-grootte);
    color: var(--kleur-voorgrond-subtiel);
  }

  .soorten {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ruimte-stapel-md) var(--ruimte-rij-md);
    grid-column: 1 / -1;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--tekst-kop4-grootte);
  }
</style>
