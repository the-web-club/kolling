---
import { render } from 'astro:content';
import CtaStrook from '@/components/CtaStrook.astro';
import Faq from '@/components/Faq.astro';
import JsonLd from '@/components/JsonLd.astro';
import Kruimelpad from '@/components/Kruimelpad.astro';
import LopendeTekst from '@/components/LopendeTekst.astro';
import MateriaalLijst from '@/components/MateriaalLijst.astro';
import ProcesStappen from '@/components/ProcesStappen.astro';
import SectieIntro from '@/components/SectieIntro.astro';
import WerkRaster from '@/components/WerkRaster.astro';
import Basis from '@/layouts/Basis.astro';
import { haalDiensten, haalProjectenOpId, type Dienst } from '@/lib/content';
import { maakKruimelpad, maakVragenpagina } from '@/lib/jsonld';
import { maakKruimels } from '@/lib/seo';

export async function getStaticPaths() {
  const diensten = await haalDiensten();
  return diensten.map((dienst) => ({ params: { slug: dienst.id }, props: { dienst } }));
}

interface Props {
  dienst: Dienst;
}

const { dienst } = Astro.props;
const { Content } = await render(dienst);
const voorbeelden = await haalProjectenOpId(
  dienst.data.gerelateerdeProjecten.map((item) => item.id),
);

if (!Astro.site) {
  throw new Error('astro.config.mjs mist de site-URL.');
}

const kruimels = maakKruimels(`/maatwerk/${dienst.id}`, {
  '/maatwerk': 'Maatwerk',
  [`/maatwerk/${dienst.id}`]: dienst.data.titel,
});
---

<Basis titel={dienst.data.seo.titel} beschrijving={dienst.data.seo.beschrijving}>
  <Fragment slot="hoofd">
    <JsonLd schema={maakKruimelpad(kruimels, Astro.site)} />
    <JsonLd schema={maakVragenpagina(dienst.data.faq)} />
  </Fragment>

  <section>
    <Kruimelpad kruimels={kruimels} />
  </section>

  <section>
    <SectieIntro label={dienst.data.titel} kop={dienst.data.kop} niveau={1}>
      <p>{dienst.data.intro}</p>
    </SectieIntro>
  </section>

  <section>
    <div class="verhaal">
      <LopendeTekst>
        <Content />
      </LopendeTekst>
    </div>
    <div class="lijsten">
      <MateriaalLijst kop="Voor wie" items={dienst.data.voorWie} />
      <MateriaalLijst kop="Materialen" items={dienst.data.materialen} />
    </div>
  </section>

  <section>
    <SectieIntro label="Werkwijze" kop="Hoe het verloopt" />
    <ProcesStappen stappen={dienst.data.proces} />
  </section>

  {
    voorbeelden.length > 0 && (
      <section>
        <SectieIntro label="Voorbeelden" kop="Werk in deze categorie" />
        <WerkRaster projecten={voorbeelden} />
      </section>
    )
  }

  <section>
    <SectieIntro label="Vragen" kop="Veelgestelde vragen" />
    <div class="vragen">
      <Faq vragen={dienst.data.faq} />
    </div>
  </section>

  <CtaStrook
    kop="Bespreek je idee"
    tekst="Stuur je idee met maten en foto's van de ruimte. Je hoort binnen twee werkdagen wat er mogelijk is."
    aanvraag={dienst.data.categorie === 'bijzonder-houtwerk' ? 'bijzonder-houtwerk' : undefined}
  />
</Basis>

<style>
  .verhaal,
  .lijsten,
  .vragen {
    grid-column: 1 / -1;
  }

  .lijsten {
    display: grid;
    gap: var(--ruimte-rij-md);
    margin-block-start: var(--ruimte-stapel-lg);
  }

  @media (min-width: 64rem) {
    .verhaal {
      grid-column: 2 / span 6;
    }

    .lijsten {
      grid-column: 9 / span 4;
      margin-block-start: 0;
    }

    .vragen {
      grid-column: 2 / span 8;
    }
  }
</style>
