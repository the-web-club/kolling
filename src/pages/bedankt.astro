---
import SectieIntro from '@/components/SectieIntro.astro';
import TekstLink from '@/components/TekstLink.astro';
import Basis from '@/layouts/Basis.astro';
import { haalInstellingen } from '@/lib/content';

const instellingen = await haalInstellingen();
---

<Basis
  titel="Bedankt"
  beschrijving="Je aanvraag is verstuurd. Thomas leest je bericht zelf en komt erop terug met een eerste reactie op je idee."
  indexeerbaar={false}
>
  <section>
    <SectieIntro label="Verstuurd" kop="Je idee staat erin" niveau={1}>
      <p>
        Thomas leest je bericht zelf. Hij komt erop terug met een eerste reactie en een voorstel
        voor de volgende stap, meestal een bezoek aan de werkplaats of een keer inmeten.
      </p>
      <p>
        Je hebt ook een bevestiging per e-mail gekregen. Zie je die niet, kijk dan tussen je
        ongewenste berichten.
      </p>
      <p>
        Haast? Bel dan
        <TekstLink href={`tel:${instellingen.telefoon.e164}`}>
          {instellingen.telefoon.weergave}
        </TekstLink>.
      </p>
      <p>
        <TekstLink href="/werk" variant="intekenend">Bekijk ondertussen het werk</TekstLink>
      </p>
    </SectieIntro>
  </section>
</Basis>
