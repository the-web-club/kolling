---
import { ClientRouter } from 'astro:transitions';
import '@/styles/basis.css';
import '@/styles/beweging.css';
import logo from '@/assets/merk/woordmerk.png';
import JsonLd from '@/components/JsonLd.astro';
import LichtAchtergrond from '@/components/LichtAchtergrond.astro';
import Seo from '@/components/Seo.astro';
import { tokens } from '@/design/tokens.gegenereerd';
import { haalInstellingen } from '@/lib/content';
import { maakLocalBusiness, maakWebsite } from '@/lib/jsonld';
import { maakTitel } from '@/lib/seo';

interface Props {
  titel: string;
  beschrijving: string;
  suffix?: boolean;
  jsonLd?: boolean;
  beelden?: readonly string[];
  voorlaadBeeld?: { srcset: string; maten: string };
}

const {
  titel,
  beschrijving,
  suffix = true,
  jsonLd = false,
  beelden = [],
  voorlaadBeeld,
} = Astro.props;
const instellingen = await haalInstellingen();

if (!Astro.site) {
  throw new Error('astro.config.mjs mist de site-URL.');
}

function tokenWaarde(naam: string): string {
  const token = tokens.find((regel) => regel.naam === naam);
  if (!token) throw new Error(`Token ${naam} ontbreekt.`);
  return token.waarde;
}

const themaLicht = tokenWaarde('k-kleur-papier-50');
const themaDonker = tokenWaarde('k-kleur-nacht-900');
const volledigeTitel = suffix ? maakTitel(titel, instellingen.seo.titelSuffix) : titel;
const werkplaats = maakLocalBusiness(instellingen, Astro.site, logo.src, beelden);
const website = maakWebsite(instellingen, Astro.site);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themaLicht} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themaDonker} media="(prefers-color-scheme: dark)" />
    <script is:inline>
      {
        const zetThema = () => {
          const wortel = document.documentElement;
          wortel.setAttribute('data-js', '');
          let keuze = null;
          try {
            keuze = localStorage.getItem('kolling-thema');
          } catch {
            keuze = null;
          }
          if (keuze === 'licht' || keuze === 'donker') wortel.setAttribute('data-thema', keuze);
        };
        zetThema();
        document.addEventListener('astro:after-swap', zetThema);
      }
    </script>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latijn.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/work-sans-latijn.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      voorlaadBeeld && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset={voorlaadBeeld.srcset}
          imagesizes={voorlaadBeeld.maten}
        />
      )
    }
    <Seo titel={volledigeTitel} beschrijving={beschrijving} />
    {jsonLd && <JsonLd schema={werkplaats} />}
    {jsonLd && <JsonLd schema={website} />}
    <ClientRouter />
  </head>
  <body>
    <LichtAchtergrond />
    <slot />
    <script>
      import { startOnthullen } from '@/lib/beweging/onthul';
      import { koppelPaginaovergang } from '@/lib/beweging/paginaovergang';
      import { koppelThema } from '@/lib/thema';

      koppelPaginaovergang();
      koppelThema();
      startOnthullen();
      document.addEventListener('astro:page-load', startOnthullen);
    </script>
  </body>
</html>
