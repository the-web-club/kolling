---
import { ClientRouter } from 'astro:transitions';
import '@/styles/basis.css';
import '@/styles/beweging.css';
import logo from '@/assets/merk/woordmerk.png';
import JsonLd from '@/components/JsonLd.astro';
import LichtAchtergrond from '@/components/LichtAchtergrond.astro';
import Seo from '@/components/Seo.astro';
import { haalInstellingen } from '@/lib/content';
import { maakLocalBusiness, maakWebsite } from '@/lib/jsonld';
import { maakTitel } from '@/lib/seo';

interface Props {
  titel: string;
  beschrijving: string;
  indexeerbaar?: boolean;
  suffix?: boolean;
  jsonLd?: boolean;
}

const { titel, beschrijving, indexeerbaar = true, suffix = true, jsonLd = false } = Astro.props;
const instellingen = await haalInstellingen();

if (!Astro.site) {
  throw new Error('astro.config.mjs mist de site-URL.');
}

const volledigeTitel = suffix ? maakTitel(titel, instellingen.seo.titelSuffix) : titel;
const werkplaats = maakLocalBusiness(instellingen, Astro.site, logo.src);
const website = maakWebsite(instellingen, Astro.site);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latijn.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/work-sans-latijn.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo titel={volledigeTitel} beschrijving={beschrijving} indexeerbaar={indexeerbaar} />
    {jsonLd && <JsonLd schema={werkplaats} />}
    {jsonLd && <JsonLd schema={website} />}
    <ClientRouter />
    <script is:inline>
      document.documentElement.setAttribute('data-js', '');
    </script>
  </head>
  <body>
    <LichtAchtergrond />
    <slot />
    <script>
      import { zetLichteBinnenkomst } from '@/lib/beweging/paginaovergang';

      zetLichteBinnenkomst();
    </script>
  </body>
</html>
